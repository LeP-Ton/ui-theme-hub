{
  "name": "boss-theme",
  "version": "1.0.0",
  "description": "B端管理系统主题，专业科技感，适合企业级应用",
  "author": "设计团队B",
  "scene": "b-end",
  "tags": ["b-end", "management", "dashboard", "enterprise"],
  "requires": [
    { "name": "antd", "source": "https://github.com/ant-design/ant-design" }
  ],
  "preview": ["examples/dashboard.png", "examples/list-page.png"],
  "repository": "https://github.com/example/ui-theme-hub",
  "license": "MIT",
  "tokens": {
    "color": {
      "primary": "#1677ff",
      "secondary": "#597ef7",
      "accent": "#13c2c2",
      "success": "#52c41a",
      "warning": "#faad14",
      "error": "#ff4d4f",
      "info": "#1677ff",
      "background": { "base": "#ffffff", "elevated": "#ffffff", "muted": "#f5f5f5" },
      "text": { "primary": "rgba(0, 0, 0, 0.88)", "secondary": "rgba(0, 0, 0, 0.65)", "muted": "rgba(0, 0, 0, 0.45)", "inverse": "#ffffff" },
      "border": { "default": "#d9d9d9", "muted": "#f0f0f0" },
      "extended": {
        "sidebarBg": "#001529",
        "sidebarText": "rgba(255, 255, 255, 0.65)",
        "sidebarActiveBg": "#1677ff",
        "headerBg": "#ffffff",
        "tableHeaderBg": "#fafafa",
        "tableStripeBg": "rgba(0, 0, 0, 0.02)",
        "hoverBg": "rgba(0, 0, 0, 0.04)"
      }
    },
    "spacing": {
      "unit": 4,
      "scale": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96],
      "extended": {
        "headerHeight": 56,
        "sidebarWidth": 240,
        "sidebarCollapsedWidth": 80,
        "contentPadding": 24,
        "cardSpacing": 16,
        "tableRowHeight": 54,
        "tableCellPaddingH": 16
      }
    },
    "typography": {
      "fontFamily": { "base": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif", "heading": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif", "code": "'SF Mono', 'Fira Code', 'Fira Mono', 'Roboto Mono', monospace" },
      "fontSize": { "xs": 12, "sm": 13, "base": 14, "lg": 16, "xl": 20, "2xl": 24, "3xl": 30, "4xl": 36 },
      "fontWeight": { "normal": 400, "medium": 500, "semibold": 600, "bold": 700 },
      "lineHeight": { "tight": 1.25, "base": 1.5, "relaxed": 1.75 }
    },
    "border": { "radius": { "none": 0, "sm": 4, "base": 6, "lg": 8, "xl": 12, "full": 9999 }, "width": { "thin": 1, "base": 1, "thick": 2 } },
    "shadow": {
      "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02)",
      "base": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px 0 rgba(0, 0, 0, 0.02)",
      "lg": "0 6px 16px 0 rgba(0, 0, 0, 0.08), 0 3px 6px -4px rgba(0, 0, 0, 0.12)",
      "xl": "0 9px 28px 8px rgba(0, 0, 0, 0.05), 0 6px 16px 0 rgba(0, 0, 0, 0.08)"
    },
    "motion": { "enabled": true, "duration": { "fast": "0.1s", "base": "0.2s", "slow": "0.3s" }, "easing": { "standard": "cubic-bezier(0.4,0,0.2,1)", "decelerate": "cubic-bezier(0,0,0.2,1)", "accelerate": "cubic-bezier(0.4,0,1,1)" } }
  }
}
