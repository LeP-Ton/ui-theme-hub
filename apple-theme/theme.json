{
  "id": "apple-theme",
  "name": "apple-theme",
  "version": "1.0.0",
  "description": "Apple 风格主题，简洁优雅，适合C端产品、营销落地页和移动端",
  "author": "设计团队C",
  "scene": "c-end",
  "tags": ["c-end", "marketing", "mobile", "apple", "elegant"],
  "requires": [
    { "name": "tailwind", "source": "https://github.com/tailwindlabs/tailwindcss" }
  ],
  "tokens": {
    "color": {
      "primary": "#fa8c16",
      "secondary": "#faad14",
      "accent": "#eb2f96",
      "success": "#52c41a",
      "warning": "#faad14",
      "error": "#ff4d4f",
      "info": "#fa8c16",
      "background": { "base": "#ffffff", "elevated": "#ffffff", "muted": "#fff7e6" },
      "text": { "primary": "rgba(0, 0, 0, 0.85)", "secondary": "rgba(0, 0, 0, 0.65)", "muted": "rgba(0, 0, 0, 0.45)", "inverse": "#ffffff" },
      "border": { "default": "#ffc069", "muted": "#ffe7ba" },
      "extended": {
        "heroGradientStart": "#fa8c16",
        "heroGradientEnd": "#faad14",
        "ctaBg": "#fa8c16",
        "ctaHoverBg": "#d87a16"
      }
    },
    "spacing": {
      "unit": 4,
      "scale": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96],
      "extended": {
        "heroHeight": 400,
        "sectionSpacing": 64,
        "containerMaxWidth": 1200,
        "containerPadding": 24,
        "navHeight": 64,
        "cardRadius": 12,
        "touchTarget": 44,
        "tabBarHeight": 50,
        "safeAreaTop": "env(safe-area-inset-top)",
        "safeAreaBottom": "env(safe-area-inset-bottom)"
      }
    },
    "typography": {
      "fontFamily": { "base": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif", "heading": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif", "code": "'SF Mono', 'Fira Code', monospace" },
      "fontSize": { "xs": 12, "sm": 13, "base": 14, "lg": 16, "xl": 20, "2xl": 24, "3xl": 30, "4xl": 36 },
      "fontWeight": { "normal": 400, "medium": 500, "semibold": 600, "bold": 700 },
      "lineHeight": { "tight": 1.25, "base": 1.5, "relaxed": 1.75 }
    },
    "border": { "radius": { "none": 0, "sm": 6, "base": 8, "lg": 12, "xl": 16, "full": 9999 }, "width": { "thin": 1, "base": 1, "thick": 2 } },
    "shadow": {
      "sm": "0 2px 4px rgba(250, 140, 22, 0.06)",
      "base": "0 2px 8px rgba(250, 140, 22, 0.08)",
      "lg": "0 6px 16px rgba(250, 140, 22, 0.1)",
      "xl": "0 9px 28px rgba(250, 140, 22, 0.12)"
    },
    "motion": { "enabled": true, "duration": { "fast": "0.1s", "base": "0.2s", "slow": "0.3s" }, "easing": { "standard": "cubic-bezier(0.4,0,0.2,1)", "decelerate": "cubic-bezier(0,0,0.2,1)", "accelerate": "cubic-bezier(0.4,0,1,1)" } }
  }
}
